(define (factorial n)
    (define (factorial-aux n acc)
        (if (= n 0)
            acc
            (factorial-aux (- n 1) (* n acc))))
    (factorial-aux n 1))

(load "lib/io.rsch")
(load "lib/format.rsch")
(define n (str->num (prompt "Enter a number: ")))
(writeln (format "factorial({}) => {}" n (factorial n)))
