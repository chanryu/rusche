#!/usr/bin/env rusche-cli
(define (fizzbuzz n)
    (define (div? n m) (= (% n m) 0))
    (cond ((div? n 15) "FizzBuzz")
          ((div? n 3) "Fizz")
          ((div? n 5) "Buzz")
          (else n)))

(load "lib/io.rsch")

(let ((n 1)
      (m (str->num (prompt "Enter a number to fizzbuzz: "))))
    (while (<= n m)
        (writeln (fizzbuzz n))
        (set! n (+ n 1))))
