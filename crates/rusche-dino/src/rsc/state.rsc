;; Canvas / sprite sizes — keep in sync with sprites.rs

(define WIDTH 600)
(define HEIGHT 150)
(define GROUND-Y 128)

(define DINO-X 44)
(define DINO-W 44)
(define DINO-H 47)
(define DINO-DUCK-W 59)
(define DINO-DUCK-H 30)

(define CACTUS-S-W 17)
(define CACTUS-S-H 35)
(define CACTUS-L-W 25)
(define CACTUS-L-H 50)
(define BIRD-W 46)
(define BIRD-H 40)

(define DIGIT-W 10)
(define DIGIT-GAP 2)
(define HI-W 36)
(define GAME-OVER-W 202)
(define GAME-OVER-H 21)
(define CLOUD-W 92)
(define CLOUD-H 28)

(define DAY-BG-R 247)
(define DAY-BG-G 247)
(define DAY-BG-B 247)
(define DAY-FG-R 83)
(define DAY-FG-G 83)
(define DAY-FG-B 83)

(define NIGHT-BG-R 32)
(define NIGHT-BG-G 32)
(define NIGHT-BG-B 32)
(define NIGHT-FG-R 247)
(define NIGHT-FG-G 247)
(define NIGHT-FG-B 247)

(define GRAVITY 2400)
(define JUMP-V -720)
(define FAST-FALL 2.2)
(define BASE-SPEED 320)
(define MAX-SPEED 720)
(define SCORE-PER-PX 0.025)
(define BIRD-AFTER 400)
(define NIGHT-BAND 700)
(define BLINK-EVERY 100)
(define BLINK-SECS 0.35)

;; MINSTD LCG — exact in f64 while state < 2^31
(define rng-state 1)

(define (rand)
    (set! rng-state (% (* 48271 rng-state) 2147483647))
    (/ rng-state 2147483647))

(define (rand-range lo hi)
    (+ lo (* (rand) (- hi lo))))

(define dead? false)
(define started? false)
(define dino-y 81)
(define dino-vy 0)
(define ducking? false)
(define anim-t 0)
(define speed BASE-SPEED)
(define score 0)
(define hi-score 0)
(define obstacles ())
(define clouds ())
(define spawn-cd 0)
(define prev-jump? false)
(define blink-t 0)
(define last-blink-mark 0)
(define ground-scroll 0)

(define (ground-dino-y)
    (- GROUND-Y DINO-H))

(define (ground-duck-y)
    (- GROUND-Y DINO-DUCK-H))

(define (reset)
    (set! dead? false)
    (set! started? false)
    (set! dino-y (ground-dino-y))
    (set! dino-vy 0)
    (set! ducking? false)
    (set! anim-t 0)
    (set! speed BASE-SPEED)
    (set! score 0)
    (set! obstacles ())
    (set! clouds (list (list 480 30) (list 200 50)))
    (set! spawn-cd 1.2)
    (set! prev-jump? false)
    (set! blink-t 0)
    (set! last-blink-mark 0)
    (set! ground-scroll 0)
    (set! rng-state 1))

(reset)
