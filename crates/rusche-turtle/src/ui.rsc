; Rusche Turtle UI — window chrome, help, REPL, and canvas.

(define script (buffer initial-script))
(define log-buf (buffer ""))
(define repl-input (buffer ""))
(define tab 'script)
(define show-help false)
(define speed 2)
(define repl-history '())
(define history-pos false)
(define focus-repl false)
(define cursor-end false)

(define (cadddr lst) (car (cdr (cddr lst))))
(define (cddddr lst) (cdr (cdr (cddr lst))))

(define (for-each proc lst)
  (if (null? lst)
      '()
      (begin
        (proc (car lst))
        (for-each proc (cdr lst)))))

(define (str-ends-with? s suffix)
  (let ((n (str-length s))
        (m (str-length suffix)))
    (if (< n m)
        false
        (= (str-slice s (- n m) n) suffix))))

(define (append-script text)
  (let ((cur (buffer-text script)))
    (if (if (= cur "") false (not (str-ends-with? cur "\n")))
        (buffer-set! script (str-append cur "\n" text "\n"))
        (buffer-set! script (str-append cur text "\n")))))

(define help-sections
  (list
    (list "Motion"
      (list "(forward dist)  ; fd" "Move forward (draws if pen down)" "(forward 50)")
      (list "(back dist)  ; bk" "Move backward" "(back 50)")
      (list "(left deg)  ; lt" "Turn left" "(left 90)")
      (list "(right deg)  ; rt" "Turn right" "(right 90)")
      (list "(goto x y)" "Absolute move" "(goto 0 0)")
      (list "(setheading deg)  ; seth" "Absolute heading" "(setheading 90)")
      (list "(home)" "Origin, face north" "(home)"))
    (list "Pen & canvas"
      (list "(penup)  ; pu" "Lift pen" "(penup)")
      (list "(pendown)  ; pd" "Lower pen" "(pendown)")
      (list "(pencolor \"blue\")" "Name or r g b" "(pencolor \"blue\")")
      (list "(pensize w)" "Stroke width" "(pensize 2)")
      (list "(clear)" "Reset canvas" "(clear)")
      (list "(hideturtle) / (showturtle)" "Sprite visibility" "(hideturtle)"))
    (list "Queries & I/O"
      (list "(position)" "→ (x y)" "(position)")
      (list "(heading)" "→ degrees (0 east, 90 north)" "(heading)")
      (list "(pen?)" "→ pen down?" "(pen?)")
      (list "(write …) / (writeln …)" "Output log" "(writeln \"hi\")")
      (list "(random)" "→ [0, 1)" "(random)")
      (list "(repeat n body…)" "Loop body n times" "(repeat 4 (forward 50) (right 90))"))))

(define speeds (list "Crawl" "Walk" "Trot" "Run" "Dash"))

(define (script-layouter text)
  (let ((spans (highlight text (dark-mode?)))
        (site (turtle-site text))
        (bg (if (dark-mode?) '(110 90 20) '(255 232 140))))
    (if (list? site)
        (mark-site spans (car site) (cadr site) bg)
        spans)))

(define (mark-site spans start end bg)
  ; `let` bindings are parallel, so dependent values need a nested let.
  (define (loop spans out)
    (if (null? spans)
        out
        (let ((a (car (car spans)))
              (b (cadr (car spans)))
              (r (caddr (car spans)))
              (g (cadddr (car spans)))
              (bl (car (cddddr (car spans)))))
          (let ((mid0 (if (< a start) start a))
                (mid1 (if (< end b) end b)))
            (loop (cdr spans)
                  (append out
                    (append
                      (if (< a mid0) (list (list a mid0 r g bl)) '())
                      (append
                        (if (< mid0 mid1)
                            (list (list mid0 mid1 r g bl (car bg) (cadr bg) (caddr bg)))
                            '())
                        (if (< mid1 b) (list (list mid1 b r g bl)) '())))))))))
  (loop spans '()))

(define (draw-help)
  (label "Turtle API" 'strong)
  (label "Origin at center, y up. Heading 0° = east, 90° = north." 'small 'weak)
  (space 4)
  (label "Click a form to append it to the script." 'small 'weak)
  (separator)
  (scroll 'vertical (lambda ()
    (for-each
      (lambda (section)
        (space 6)
        (label (car section) 'strong)
        (for-each
          (lambda (op)
            (let ((form (car op))
                  (blurb (cadr op))
                  (insert (caddr op)))
              (when (button form)
                (append-script insert))
              (hover (str-append "Insert `" insert "`"))
              (label blurb 'small 'weak)
              (space 2)))
          (cdr section)))
      help-sections))))

(define (draw-editor-controls)
  (horizontal (lambda ()
    (let ((running (turtle-running?)))
      (when (if running false (button "Run"))
        (turtle-run (buffer-text script)))
      (when (if running (button "Stop") false)
        (turtle-stop))
      (when (if running false (button "Reset"))
        (turtle-reset)
        (buffer-set! log-buf ""))
      (separator)
      (menu "Examples" (lambda ()
        (for-each
          (lambda (ex)
            (when (button (car ex))
              (buffer-set! script (cadr ex))
              (close-menu)))
          (turtle-examples))))))))

(define (draw-script-tab)
  (draw-editor-controls)
  (separator)
  (bottom-panel "log" 160 (lambda ()
    (label "Output" 'strong)
    (turtle-output log-buf)
    (scroll 'vertical 'stick-to-bottom (lambda ()
      (text-edit log-buf 'code 'read-only)))))
  (scroll 'both (lambda ()
    (text-edit script 'code 'rows 30 script-layouter))))

(define (history-prev)
  (when (not (null? repl-history))
    (if (= history-pos false)
        (set! history-pos (- (length repl-history) 1))
        (when (> history-pos 0)
          (set! history-pos (- history-pos 1))))
    (buffer-set! repl-input (nth repl-history history-pos))
    (set! cursor-end true)))

(define (history-next)
  (when (not (= history-pos false))
    (if (>= (+ history-pos 1) (length repl-history))
        (begin
          (set! history-pos false)
          (buffer-set! repl-input ""))
        (begin
          (set! history-pos (+ history-pos 1))
          (buffer-set! repl-input (nth repl-history history-pos))))
    (set! cursor-end true)))

(define (submit-repl)
  (let ((source (str-trim (buffer-text repl-input))))
    (cond
      ((= source "")
        (buffer-set! repl-input ""))
      ((form-complete? (buffer-text repl-input))
        (set! repl-history (append repl-history (list source)))
        (set! history-pos false)
        (turtle-repl source)
        (buffer-set! repl-input "")
        (set! focus-repl true))
      (true
        (let ((cur (buffer-text repl-input)))
          (when (not (str-ends-with? cur "\n"))
            (buffer-set! repl-input (str-append cur "\n"))))))))

(define (draw-repl-input running)
  (label "Enter evaluates, Shift+Enter inserts a newline." 'small 'weak)
  (when cursor-end
    (buffer-cursor! repl-input 'end)
    (set! cursor-end false))
  (let ((focused
          (if focus-repl
              (text-edit repl-input 'code 'rows 3 'submit-on-enter 'focus
                (lambda (text) (highlight text (dark-mode?))))
              (text-edit repl-input 'code 'rows 3 'submit-on-enter
                (lambda (text) (highlight text (dark-mode?)))))))
    (set! focus-repl false)
    (when (if running false focused)
      (when (if (key-pressed? 'enter) (not (shift-down?)) false)
        (submit-repl))
      (when (if (key-pressed? 'up)
                (= (str-find (buffer-text repl-input) "\n") false)
                false)
        (history-prev))
      (when (if (key-pressed? 'down)
                (= (str-find (buffer-text repl-input) "\n") false)
                false)
        (history-next)))))

(define (draw-repl-tab)
  (let ((running (turtle-running?)))
    (horizontal (lambda ()
      (when (if running (button "Stop") false)
        (turtle-stop))
      (when (if running false (button "Reset"))
        (turtle-reset)
        (buffer-set! log-buf ""))))
    (separator)
    (bottom-panel "repl_input" 100 (lambda () (draw-repl-input running)))
    (scroll 'vertical 'stick-to-bottom (lambda ()
      (let ((entries (turtle-transcript)))
        (if (null? entries)
            (label "Evaluate expressions here." 'weak 'italics)
            (for-each
              (lambda (entry)
                (let ((kind (car entry))
                      (text (cadr entry)))
                  (cond
                    ((= kind 'input)
                      (label (str-append "> " text) 'monospace))
                    ((= kind 'output)
                      (label text 'monospace))
                    ((= kind 'result)
                      (label (str-append "=> " text) 'monospace 'weak))
                    ((= kind 'error)
                      (label text 'monospace '(180 40 40))))))
              entries)))))))

(define (screen-x origin-x x) (+ origin-x x))
(define (screen-y origin-y y) (- origin-y y))

(define (heading-at cx cy heading along across)
  (let ((rad (* heading 0.017453292519943295)))
    (let ((fx (cos rad))
          (fy (- 0 (sin rad)))
          (rx (sin rad))
          (ry (cos rad)))
      (list (+ cx (* fx along) (* rx across))
            (+ cy (* fy along) (* ry across))))))

(define (draw-turtle-sprite painter cx cy heading)
  (let ((shell '(56 142 60))
        (shell-dark '(27 94 32))
        (skin '(129 199 132))
        (skin-dark '(46 125 50))
        (outline '(27 54 30)))
    (define (at along across) (heading-at cx cy heading along across))
    (define (flipper tip a b)
      (polygon painter (list tip a b) skin outline 1))
    (flipper (at 6 9) (at 1 3) (at 5 2))
    (flipper (at 6 -9) (at 1 -3) (at 5 -2))
    (flipper (at -7 8) (at -2 3) (at -5 2))
    (flipper (at -7 -8) (at -2 -3) (at -5 -2))
    (polygon painter (list (at -11 0) (at -6 2.5) (at -6 -2.5)) skin outline 1)
    (circle painter cx cy 8.5 shell outline 1)
    (circle painter cx cy 5 shell-dark false 0)
    (line painter (car (at 0 -4.5)) (cadr (at 0 -4.5)) (car (at 0 4.5)) (cadr (at 0 4.5)) shell-dark 1)
    (line painter (car (at -4 -2.5)) (cadr (at -4 -2.5)) (car (at 4 2.5)) (cadr (at 4 2.5)) shell-dark 1)
    (line painter (car (at -4 2.5)) (cadr (at -4 2.5)) (car (at 4 -2.5)) (cadr (at 4 -2.5)) shell-dark 1)
    (let ((head (at 11 0))
          (e1 (at 12 1.8))
          (e2 (at 12 -1.8))
          (p1 (at 12.4 1.8))
          (p2 (at 12.4 -1.8)))
      (circle painter (car head) (cadr head) 4 skin outline 1)
      (circle painter (car e1) (cadr e1) 1.1 '(255 255 255) false 0)
      (circle painter (car e2) (cadr e2) 1.1 '(255 255 255) false 0)
      (circle painter (car p1) (cadr p1) 0.55 skin-dark false 0)
      (circle painter (car p2) (cadr p2) 0.55 skin-dark false 0))))

(define (draw-status-badge painter x y)
  (let ((text (turtle-status))
        (pad 6)
        (margin 8)
        (swatch 14)
        (gap 8)
        (row-h 14)
        (text-w 130)
        (pen (turtle-pen)))
    (let ((badge-x (+ x margin))
          (badge-y (+ y margin))
          (badge-w (+ pad swatch gap text-w pad))
          (badge-h (+ (* pad 2) (* row-h 6))))
      (fill-rect painter badge-x badge-y badge-w badge-h '(255 255 255))
      (stroke-rect painter badge-x badge-y badge-w badge-h '(200 200 200) 1)
      (fill-rect painter (+ badge-x pad) (+ badge-y pad (* row-h 3)) swatch swatch
                 (list (cadr pen) (caddr pen) (cadddr pen)))
      (stroke-rect painter (+ badge-x pad) (+ badge-y pad (* row-h 3)) swatch swatch
                   '(120 120 120) 1)
      (paint-text painter (+ badge-x pad swatch gap) (+ badge-y pad) text 12 '(40 40 40)))))

(define (draw-canvas-body painter x y w h)
  (fill-rect painter x y w h '(250 250 248))
  (let ((ox (+ x (/ w 2)))
        (oy (+ y (/ h 2))))
    (line painter x oy (+ x w) oy '(220 220 220) 1)
    (line painter ox y ox (+ y h) '(220 220 220) 1)
    (for-each
      (lambda (seg)
        (line painter
              (screen-x ox (car seg))
              (screen-y oy (cadr seg))
              (screen-x ox (caddr seg))
              (screen-y oy (cadddr seg))
              (list (nth seg 4) (nth seg 5) (nth seg 6))
              (nth seg 7)))
      (turtle-segments))
    (let ((pose (turtle-pose)))
      (when (cadddr pose)
        (draw-turtle-sprite painter
                           (screen-x ox (car pose))
                           (screen-y oy (cadr pose))
                           (caddr pose))))
    (draw-status-badge painter x y)))

(define (draw-canvas-controls)
  (horizontal (lambda ()
    (when (button "Clear")
      (turtle-clear))
    (separator)
    (label "Speed" 'small 'weak)
    (let ((i 0))
      (for-each
        (lambda (label)
          (when (selectable (= speed i) label)
            (set! speed i)
            (turtle-speed! i))
          (set! i (+ i 1)))
        speeds)))))

(define (ui)
  (when (turtle-frame)
    (request-repaint))
  (left-panel "side" 360 (lambda ()
    (horizontal (lambda ()
      (when (selectable (= tab 'script) "Script")
        (set! tab 'script))
      (when (selectable (= tab 'repl) "REPL")
        (set! tab 'repl))
      (right-to-left (lambda ()
        (set! show-help (toggle show-help "Help"))))))
    (separator)
    (if (= tab 'script)
        (draw-script-tab)
        (draw-repl-tab))))
  (when show-help
    (right-panel "help" 280 (lambda () (draw-help))))
  (central-panel (lambda ()
    (let ((h (- (available-height) (interact-height))))
      (canvas (if (< h 40) 40 h) draw-canvas-body)
      (draw-canvas-controls))))
  (when (turtle-running?)
    (request-repaint)))

(run-app "Rusche Turtle" 1100 720 ui)
