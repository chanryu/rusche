; Top-level frame procedure and window entry.

(define (ui)
  (when (turtle-frame)
    (request-repaint))
  (left-panel "side" 360 (lambda ()
    (horizontal (lambda ()
      (when (selectable (= tab 'script) "Script")
        (set! tab 'script))
      (when (selectable (= tab 'repl) "REPL")
        (set! tab 'repl))
      (right-to-left (lambda ()
        (set! show-help (toggle show-help "Help"))))))
    (separator)
    (if (= tab 'script)
        (draw-script-tab)
        (draw-repl-tab))))
  (when show-help
    (right-panel "help" 280 (lambda () (draw-help))))
  (central-panel (lambda ()
    (let ((h (- (available-height) (interact-height))))
      (canvas (if (< h 40) 40 h) draw-canvas-body)
      (draw-canvas-controls))))
  (when (turtle-running?)
    (request-repaint)))

(run-app "Rusche Turtle" 1100 720 ui)
