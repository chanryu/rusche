; Central canvas: trails, turtle sprite, status badge, Clear/Speed.

(define (screen-x origin-x x) (+ origin-x x))
(define (screen-y origin-y y) (- origin-y y))

(define (heading-at cx cy heading along across)
  (let ((rad (* heading 0.017453292519943295)))
    (let ((fx (cos rad))
          (fy (- 0 (sin rad)))
          (rx (sin rad))
          (ry (cos rad)))
      (list (+ cx (* fx along) (* rx across))
            (+ cy (* fy along) (* ry across))))))

(define (draw-turtle-sprite painter cx cy heading)
  (let ((shell '(56 142 60))
        (shell-dark '(27 94 32))
        (skin '(129 199 132))
        (skin-dark '(46 125 50))
        (outline '(27 54 30)))
    (define (at along across) (heading-at cx cy heading along across))
    (define (flipper tip a b)
      (polygon painter (list tip a b) skin outline 1))
    (flipper (at 6 9) (at 1 3) (at 5 2))
    (flipper (at 6 -9) (at 1 -3) (at 5 -2))
    (flipper (at -7 8) (at -2 3) (at -5 2))
    (flipper (at -7 -8) (at -2 -3) (at -5 -2))
    (polygon painter (list (at -11 0) (at -6 2.5) (at -6 -2.5)) skin outline 1)
    (circle painter cx cy 8.5 shell outline 1)
    (circle painter cx cy 5 shell-dark false 0)
    (line painter (car (at 0 -4.5)) (cadr (at 0 -4.5)) (car (at 0 4.5)) (cadr (at 0 4.5)) shell-dark 1)
    (line painter (car (at -4 -2.5)) (cadr (at -4 -2.5)) (car (at 4 2.5)) (cadr (at 4 2.5)) shell-dark 1)
    (line painter (car (at -4 2.5)) (cadr (at -4 2.5)) (car (at 4 -2.5)) (cadr (at 4 -2.5)) shell-dark 1)
    (let ((head (at 11 0))
          (e1 (at 12 1.8))
          (e2 (at 12 -1.8))
          (p1 (at 12.4 1.8))
          (p2 (at 12.4 -1.8)))
      (circle painter (car head) (cadr head) 4 skin outline 1)
      (circle painter (car e1) (cadr e1) 1.1 '(255 255 255) false 0)
      (circle painter (car e2) (cadr e2) 1.1 '(255 255 255) false 0)
      (circle painter (car p1) (cadr p1) 0.55 skin-dark false 0)
      (circle painter (car p2) (cadr p2) 0.55 skin-dark false 0))))

(define (draw-status-badge painter x y)
  (let ((text (turtle-status))
        (pad 6)
        (margin 8)
        (swatch 14)
        (gap 8)
        (row-h 14)
        (text-w 130)
        (pen (turtle-pen)))
    (let ((badge-x (+ x margin))
          (badge-y (+ y margin))
          (badge-w (+ pad swatch gap text-w pad))
          (badge-h (+ (* pad 2) (* row-h 6))))
      (fill-rect painter badge-x badge-y badge-w badge-h '(255 255 255))
      (stroke-rect painter badge-x badge-y badge-w badge-h '(200 200 200) 1)
      (fill-rect painter (+ badge-x pad) (+ badge-y pad (* row-h 3)) swatch swatch
                 (list (cadr pen) (caddr pen) (cadddr pen)))
      (stroke-rect painter (+ badge-x pad) (+ badge-y pad (* row-h 3)) swatch swatch
                   '(120 120 120) 1)
      (paint-text painter (+ badge-x pad swatch gap) (+ badge-y pad) text 12 '(40 40 40)))))

(define (draw-canvas-body painter x y w h)
  (fill-rect painter x y w h '(250 250 248))
  (let ((ox (+ x (/ w 2)))
        (oy (+ y (/ h 2))))
    (line painter x oy (+ x w) oy '(220 220 220) 1)
    (line painter ox y ox (+ y h) '(220 220 220) 1)
    (for-each
      (lambda (seg)
        (line painter
              (screen-x ox (car seg))
              (screen-y oy (cadr seg))
              (screen-x ox (caddr seg))
              (screen-y oy (cadddr seg))
              (list (nth seg 4) (nth seg 5) (nth seg 6))
              (nth seg 7)))
      (turtle-segments))
    (let ((pose (turtle-pose)))
      (when (cadddr pose)
        (draw-turtle-sprite painter
                           (screen-x ox (car pose))
                           (screen-y oy (cadr pose))
                           (caddr pose))))
    (draw-status-badge painter x y)))

(define (draw-canvas-controls)
  (horizontal (lambda ()
    (when (button "Clear")
      (turtle-clear))
    (separator)
    (label "Speed" 'small 'weak)
    (let ((i 0))
      (for-each
        (lambda (label)
          (when (selectable (= speed i) label)
            (set! speed i)
            (turtle-speed! i))
          (set! i (+ i 1)))
        speeds)))))
