; REPL tab: history, prompt, and transcript.

(define (history-prev)
  (when (not (null? repl-history))
    (if (= history-pos false)
        (set! history-pos (- (length repl-history) 1))
        (when (> history-pos 0)
          (set! history-pos (- history-pos 1))))
    (buffer-set! repl-input (nth repl-history history-pos))
    (set! cursor-end true)))

(define (history-next)
  (when (not (= history-pos false))
    (if (>= (+ history-pos 1) (length repl-history))
        (begin
          (set! history-pos false)
          (buffer-set! repl-input ""))
        (begin
          (set! history-pos (+ history-pos 1))
          (buffer-set! repl-input (nth repl-history history-pos))))
    (set! cursor-end true)))

(define (submit-repl)
  (let ((source (str-trim (buffer-text repl-input))))
    (cond
      ((= source "")
        (buffer-set! repl-input ""))
      ((form-complete? (buffer-text repl-input))
        (set! repl-history (append repl-history (list source)))
        (set! history-pos false)
        (turtle-repl source)
        (buffer-set! repl-input "")
        (set! focus-repl true))
      (true
        (let ((cur (buffer-text repl-input)))
          (when (not (str-ends-with? cur "\n"))
            (buffer-set! repl-input (str-append cur "\n"))))))))

(define (draw-repl-input running)
  (label "Enter evaluates, Shift+Enter inserts a newline." 'small 'weak)
  (when cursor-end
    (buffer-cursor! repl-input 'end)
    (set! cursor-end false))
  (let ((focused
          (if focus-repl
              (text-edit repl-input 'code 'rows 3 'submit-on-enter 'focus
                (lambda (text) (highlight text)))
              (text-edit repl-input 'code 'rows 3 'submit-on-enter
                (lambda (text) (highlight text))))))
    (set! focus-repl false)
    (when (if running false focused)
      (when (if (key-pressed? 'enter) (not (shift-down?)) false)
        (submit-repl))
      (when (if (key-pressed? 'up)
                (= (str-find (buffer-text repl-input) "\n") false)
                false)
        (history-prev))
      (when (if (key-pressed? 'down)
                (= (str-find (buffer-text repl-input) "\n") false)
                false)
        (history-next)))))

(define (draw-repl-tab)
  (let ((running (turtle-running?)))
    (horizontal (lambda ()
      (when (if running (button "Stop") false)
        (turtle-stop))
      (when (if running false (button "Reset"))
        (turtle-reset)
        (buffer-set! log-buf ""))))
    (separator)
    (bottom-panel "repl_input" 100 (lambda () (draw-repl-input running)))
    (scroll 'vertical 'stick-to-bottom (lambda ()
      (let ((entries (turtle-transcript)))
        (if (null? entries)
            (label "Evaluate expressions here." 'weak 'italics)
            (for-each
              (lambda (entry)
                (let ((kind (car entry))
                      (text (cadr entry)))
                  (cond
                    ((= kind 'input)
                      (label (str-append "> " text) 'monospace))
                    ((= kind 'output)
                      (label text 'monospace))
                    ((= kind 'result)
                      (label (str-append "=> " text) 'monospace 'weak))
                    ((= kind 'error)
                      (label text 'monospace '(180 40 40))))))
              entries)))))))
